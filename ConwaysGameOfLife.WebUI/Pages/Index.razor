@page "/"

<PageTitle>Conway's Game of Life</PageTitle>

<h1>Conway's Game of Life</h1>

<div
    class="life-grid"
    role="grid"
    aria-label="Game of Life grid"
    style="--life-cols:@ViewWidth; --life-cell-size:@CellSizePx">
    @for (var y = 0; y < ViewHeight; y++)
    {
        @for (var x = 0; x < ViewWidth; x++)
        {
            var isAlive = IsAliveInView(x, y);
            var worldX = _originX + x;
            var worldY = _originY + y;

            <div
                class="life-cell @(isAlive ? "is-alive" : "is-dead")"
                role="gridcell"
                aria-label="Cell @worldX,@worldY: @(isAlive ? "alive" : "dead")">
            </div>
        }
    }
</div>

<button type="button" @onclick="PanLeft">Left</button>
<button type="button" @onclick="PanRight">Right</button>
<button type="button" @onclick="PanUp">Up</button>
<button type="button" @onclick="PanDown">Down</button>
<button type="button" @onclick="Next">Next</button>