@page "/"

<h1>Conway's Game of Life</h1>

@if (RenderedBoard is null)
{
    <p>Loading baseline board...</p>
}
else
{
    <table>
        <tbody>
            @foreach (var row in RenderedBoard.Rows)
            {
                <tr>
                    @foreach (var cell in row.Cells)
                    {
                        <td>@(cell.IsAlive ? "O" : ".")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}